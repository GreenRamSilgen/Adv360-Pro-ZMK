#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        leftHRM: leftHRM {
            compatible = "zmk,behavior-hold-tap";
            label = "LEFTHRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <22 23 24 25 26 40 41 42 43 44 54 55 57 56 58 8 9 10 11 12 13 27 45 59 74 73 71 72 75 21 7 39 53 37 38 69 68 70>;
            hold-trigger-on-release;
        };

        rightHRM: rightHRM {
            compatible = "zmk,behavior-hold-tap";
            label = "RIGHTHRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 6 14 15 16 17 18 19 20 28 29 30 31 32 33 34 35 36 46 47 48 49 50 51 52 60 61 62 63 64 65 66 67>;
        };
    };

    macros {
        extronEmail: extronEmail {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp K &kp S &kp H &kp R &kp E &kp S &kp T &kp H &kp A>,
                <&macro_wait_time 100>,
                <&kt LSHIFT>,
                <&macro_wait_time 100>,
                <&kp N2>,
                <&macro_wait_time 100>,
                <&kt LSHIFT>,
                <&macro_wait_time 100>,
                <&kp E &kp X &kp T &kp R &kp O &kp N &kp DOT &kp C &kp O &kp M>;

            label = "EXTRONEMAIL";
            wait-ms = <25>;
        };

        extronPass: extronPass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kt LSHIFT>,
                <&macro_wait_time 100>,
                <&kp K>,
                <&macro_wait_time 100>,
                <&kt LSHIFT>,
                <&macro_wait_time 100>,
                <&kp A &kp F &kp U &kp U>,
                <&macro_wait_time 100>,
                <&kt LSHIFT>,
                <&macro_wait_time 100>,
                <&kp K>,
                <&macro_wait_time 100>,
                <&kt LSHIFT>,
                <&macro_wait_time 100>,
                <&kp A &kp F &kp U &kp U &kp N2 &kp N0 &kp N1 &kp N6 &kp EXCL>;

            label = "EXTRONPASS";
            wait-ms = <35>;
            tap-ms = <35>;
        };

        extAltPass: extAltPass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_wait_time 100>,
                <&kt LSHIFT>,
                <&macro_wait_time 100>,
                <&kp K>,
                <&macro_wait_time 100>,
                <&kt LSHIFT>,
                <&macro_wait_time 100>,
                <&kp A &kp F &kp U &kp U &kp U &kp N1 &kp N9 &kp N9 &kp N8>,
                <&macro_wait_time 100>,
                <&kt LSHIFT>,
                <&macro_wait_time 100>,
                <&kp N1>,
                <&macro_wait_time 100>,
                <&kt LSHIFT>,
                <&macro_wait_time 100>;

            label = "EXTALTPASS";
            wait-ms = <35>;
            tap-ms = <35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1                 &kp N2            &kp N3               &kp N4               &kp N5  &tog 1                                                                   &mo 3      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0         &tog 7
&kp TAB    &kp Q                  &kp W             &kp E                &kp R                &kp T   &none                                                                    &none      &kp Y   &kp U   &kp I      &kp O     &kp P          &kp BSLH
&kp ESC    &leftHRM LEFT_SHIFT A  &leftHRM LCTRL S  &leftHRM LEFT_GUI D  &leftHRM LEFT_ALT F  &kp G   &kp ESCAPE  &mo 4    &kp LEFT_CONTROL      &kp RIGHT_CONTROL  &mo 6      &none      &kp H   &kp J   &kp K      &kp L     &kp SEMICOLON  &kp SQT
&kp LSHFT  &kp Z                  &kp X             &kp C                &kp V                &kp B                        &kp LGUI              &kp PAGE_UP                              &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH       &kp RSHFT
&tog 5     &kp GRAVE              &kp CAPS          &kp LEFT             &kp RIGHT                    &kp BSPC    &kp DEL  &kp LEFT_ALT          &kp PAGE_DOWN      &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT       &tog 2
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3    &kp N4     &kp N5  &trans                                                   &mo 3      &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp Q      &kp W     &kp E     &kp R      &kp T   &none                                                    &none      &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp A      &kp S     &kp D     &kp F      &kp G   &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp Z      &kp X     &kp C     &kp V      &kp B                        &kp HOME      &kp PG_UP                        &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 2      &kp GRAVE  &kp CAPS  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 2
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &none                                                   &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans        &trans        &trans        &trans        &trans        &none                                                   &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &kp A         &kp S         &kp D         &kp F         &trans        &none      &kp LCTRL  &kp LEFT_ALT      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans        &trans        &trans        &trans        &trans                              &kp P             &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans        &trans        &trans        &trans                      &kp SPACE  &kp LCTRL  &trans            &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        ArrowNumMac {
            display-name = "Red";
            bindings = <
&trans  &kp F1    &kp F2      &kp F3             &kp F4           &kp F5   &tog 1                                      &mo 3            &kp F7  &extronEmail     &extronPass      &extAltPass      &kp F11  &kp F12
&trans  &kp HOME  &trans      &kp UP             &trans           &kp END  &none                                       &none            &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans   &trans
&trans  &trans    &kp LEFT    &kp DOWN           &kp RIGHT        &trans   &none   &trans  &trans      &trans  &trans  &none            &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &trans   &trans
&trans  &trans    &trans      &trans             &trans           &trans                   &trans      &trans                           &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans   &trans
&trans  &trans    &kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP           &trans  &trans  &trans      &trans  &trans  &kp KP_NUMBER_0          &trans           &trans           &trans           &trans   &trans
            >;
        };

        WASD {
            display-name = "Purple";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &tog 1                                                   &mo 3   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp T   &kp Q   &kp W   &kp E   &kp R   &none                                                    &none   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp G   &kp A   &kp S   &kp D   &kp F   &none      &kp LEFT_CONTROL  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp B   &kp Z   &kp X   &kp C   &kp V                                &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &kp SPACE  &kp LEFT_ALT      &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        Symbol {
            display-name = "Cyan";
            bindings = <
&trans           &kp GRAVE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON     &kp COMMA     &none                                                                   &none                  &trans         &trans          &trans            &trans        &trans        &trans
&kp EXCLAMATION  &kp LEFT_BRACE  &kp SINGLE_QUOTE      &kp DOUBLE_QUOTES      &kp RIGHT_BRACE   &kp QUESTION  &kp LEFT_BRACKET                                                        &kp RIGHT_BRACKET      &kp SEMICOLON  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_WIN  &trans
&kp POUND        &kp CARET       &kp EQUAL             &kp UNDERSCORE         &kp DOLLAR        &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp BACKSLASH  &kp PERIOD         &trans  &trans  &kp RIGHT_PARENTHESIS  &kp PERIOD     &kp BACKSPACE   &kp TAB           &kp SPACE     &kp ENTER     &trans
&kp TILDE        &kp LESS_THAN   &kp PIPE              &kp MINUS              &kp GREATER_THAN  &kp SLASH                                          &kp ASTERISK       &trans                                 &kp SLASH      &kp DELETE      &trans            &trans        &trans        &trans
&kp AT_SIGN      &kp AMPERSAND   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PLUS                        &kp PERCENT           &kp COLON      &kp SEMICOLON      &trans  &trans  &trans                                &trans          &trans            &trans        &trans        &trans
            >;
        };

        ColemakDH {
            display-name = "Yellow";
            bindings = <
&kp EQUAL  &kp N1                 &kp N2            &kp N3               &kp N4               &kp N5  &tog 1                                                                   &mo 3      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0         &trans
&kp TAB    &kp Q                  &kp W             &kp F                &kp P                &kp B   &none                                                                    &none      &kp J   &kp L   &kp I      &kp Y     &kp SEMICOLON  &kp BSLH
&kp ESC    &leftHRM LEFT_SHIFT A  &leftHRM LCTRL R  &leftHRM LEFT_GUI S  &leftHRM LEFT_ALT T  &kp G   &kp ESCAPE  &mo 4    &kp LEFT_CONTROL      &kp RIGHT_CONTROL  &mo 6      &none      &kp M   &kp N   &kp E      &kp I     &kp O          &kp SQT
&kp LSHFT  &kp Z                  &kp X             &kp C                &kp D                &kp V                        &kp LGUI              &kp PAGE_UP                              &kp K   &kp H   &kp COMMA  &kp DOT   &kp FSLH       &kp RSHFT
&trans     &kp GRAVE              &kp CAPS          &kp LEFT             &kp RIGHT                    &kp BSPC    &kp DEL  &kp LEFT_ALT          &kp PAGE_DOWN      &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT       &trans
            >;
        };

        extra3 {
            display-name = "Cyan";
            status = "reserved";
        };
    };
};
